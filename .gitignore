```
# TypeScript/JavaScript build artifacts
*.tsbuildinfo
*.js
*.jsx
*.ts
*.tsx

# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Logs and temp files
*.log
*.tmp

# Environment variables
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python related (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Compiled binaries
*.exe
*.dll
*.so
*.a
*.obj
*.out
```