
{
  "entities": {
    "Aluno": {
      "title": "Aluno",
      "type": "object",
      "description": "Representa um aluno registrado no sistema.",
      "properties": {
        "nome": { "type": "string" },
        "matricula": { "type": "string", "description": "Número único de identificação do aluno." },
        "segmento": { "type": "string", "description": "Nível de ensino (ex: Infantil, Fundamental)." },
        "turma": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "customData": { "type": "object" },
        "modeloId": { "type": "string" },
        "enabled": { "type": "boolean", "description": "Se o aluno está selecionado para o PDF atual." },
        "visivelFila": { "type": "boolean", "description": "Se o aluno aparece na lista do Gerenciador de Crachás." },
        "ativo": { "type": "boolean", "description": "Se o aluno está matriculado/ativo na escola." }
      },
      "required": ["nome", "matricula", "segmento", "turma", "fotoUrl"]
    },
    "ModeloCracha": {
      "title": "ModeloCracha",
      "type": "object",
      "description": "Configurações de design de um modelo de crachá.",
      "properties": {
        "nomeModelo": { "type": "string" },
        "fundoCrachaUrl": { "type": "string" },
        "badgeStyle": { "type": "object" },
        "userId": { "type": "string" }
      },
      "required": ["nomeModelo"]
    },
    "Segmento": {
      "title": "Segmento",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "ordem": { "type": "number" }
      },
      "required": ["nome", "ordem"]
    },
    "Turma": {
      "title": "Turma",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "segmentoId": { "type": "string" },
        "ordem": { "type": "number" }
      },
      "required": ["nome", "segmentoId", "ordem"]
    },
    "Configuracao": {
      "title": "Configuração",
      "type": "object",
      "description": "Configurações globais do sistema.",
      "properties": {
        "logoUrl": { "type": "string", "description": "URL ou Base64 do logo do sistema." },
        "logoHeight": { "type": "number", "description": "Altura do logo em pixels." },
        "apiSecret": { "type": "string", "description": "Chave de segurança para espelhamento automático." }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/alunos/{alunoId}": {
      "schema": { "$ref": "#/backend/entities/Aluno" },
      "description": "Coleção de alunos."
    },
    "/modelosCracha/{modeloId}": {
      "schema": { "$ref": "#/backend/entities/ModeloCracha" },
      "description": "Modelos de design de crachás salvos pelos usuários."
    },
    "/segmentos/{segmentoId}": {
      "schema": { "$ref": "#/backend/entities/Segmento" },
      "description": "Lista de segmentos configurados."
    },
    "/turmas/{turmaId}": {
      "schema": { "$ref": "#/backend/entities/Turma" },
      "description": "Lista de turmas configuradas."
    },
    "/configuracoes/{configId}": {
      "schema": { "$ref": "#/backend/entities/Configuracao" },
      "description": "Documentos de configuração do sistema."
    }
  }
}
