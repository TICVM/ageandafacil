
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "COORDINATOR", "TEACHER"] },
        "classIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lista de IDs das turmas atribuídas ao professor."
        },
        "segmentIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lista de IDs dos segmentos atribuídos ao coordenador."
        }
      }
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "schoolSegmentId": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "SchoolSegment": {
      "title": "SchoolSegment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolClassId": { "type": "string" },
        "teacherName": { "type": "string" },
        "photoLocationId": { "type": "string" },
        "locationIdentifier": { "type": "string" },
        "appointmentDate": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" },
        "observations": { "type": "string" },
        "aiBrief": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ScheduleBlock": {
      "title": "ScheduleBlock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/school_classes/{classId}", "definition": { "entityName": "SchoolClass" } },
      { "path": "/school_segments/{segmentId}", "definition": { "entityName": "SchoolSegment" } },
      { "path": "/appointments/{appointmentId}", "definition": { "entityName": "Appointment" } },
      { "path": "/photo_locations/{locationId}", "definition": { "entityName": "PhotoLocation" } },
      { "path": "/available_time_slots/{slotId}", "definition": { "entityName": "TimeSlot" } },
      { "path": "/schedule_blocks/{blockId}", "definition": { "entityName": "ScheduleBlock" } },
      { "path": "/users/{userId}", "definition": { "entityName": "User" } }
    ]
  }
}
