
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "roleId": { "type": "string" },
        "classIds": { "type": "array", "items": { "type": "string" } },
        "segmentIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RoleConfig": {
      "title": "RoleConfig",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "canManageUsers": { "type": "boolean" },
        "canConfigureSlots": { "type": "boolean" },
        "canManageLocations": { "type": "boolean" },
        "canManageClasses": { "type": "boolean" },
        "canViewReports": { "type": "boolean" },
        "canViewAllAppointments": { "type": "boolean" },
        "canViewSegmentAppointments": { "type": "boolean" },
        "canViewClassAppointments": { "type": "boolean" },
        "canEditAppointments": { "type": "boolean" },
        "canCancelAppointments": { "type": "boolean" },
        "canDeleteAppointments": { "type": "boolean" },
        "canCreateBookings": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/school_classes/{classId}": { "schema": "SchoolClass", "description": "Classes" },
    "/school_segments/{segmentId}": { "schema": "SchoolSegment", "description": "Segments" },
    "/appointments/{appointmentId}": { "schema": "Appointment", "description": "Bookings" },
    "/photo_locations/{locationId}": { "schema": "PhotoLocation", "description": "Locations" },
    "/available_time_slots/{slotId}": { "schema": "TimeSlot", "description": "Slots" },
    "/schedule_blocks/{blockId}": { "schema": "ScheduleBlock", "description": "Blocks" },
    "/users/{userId}": { "schema": "User", "description": "Users" },
    "/roles_config/{roleId}": { "schema": "RoleConfig", "description": "Role configurations" }
  }
}
