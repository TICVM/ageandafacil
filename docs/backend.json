
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "roleId": { "type": "string" },
        "classIds": { "type": "array", "items": { "type": "string" } },
        "segmentIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RoleConfig": {
      "title": "RoleConfig",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "canManageUsers": { "type": "boolean" },
        "canConfigureSlots": { "type": "boolean" },
        "canManageLocations": { "type": "boolean" },
        "canManageClasses": { "type": "boolean" },
        "canViewReports": { "type": "boolean" },
        "canViewAllAppointments": { "type": "boolean" },
        "canViewSegmentAppointments": { "type": "boolean" },
        "canViewClassAppointments": { "type": "boolean" },
        "canEditAppointments": { "type": "boolean" },
        "canCancelAppointments": { "type": "boolean" },
        "canDeleteAppointments": { "type": "boolean" },
        "canCreateBookings": { "type": "boolean" },
        "canChangeStatus": { "type": "boolean" }
      }
    },
    "HistoryEntry": {
      "title": "HistoryEntry",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string", "enum": ["CRIACAO", "ALTERACAO_DE_STATUS", "REAGENDAMENTO"] },
        "details": { "type": "string" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolClassId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "photoLocationId": { "type": "string" },
        "locationIdentifier": { "type": "string" },
        "appointmentDate": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED", "RESCHEDULED", "RE_SCHEDULE_REQUEST"] },
        "observations": { "type": "string" },
        "history": { "type": "array", "items": { "$ref": "#/entities/HistoryEntry" } }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/school_classes/{classId}": { "schema": "SchoolClass", "description": "Classes" },
    "/school_segments/{segmentId}": { "schema": "SchoolSegment", "description": "Segments" },
    "/appointments/{appointmentId}": { "schema": "Appointment", "description": "Bookings" },
    "/photo_locations/{locationId}": { "schema": "PhotoLocation", "description": "Locations" },
    "/available_time_slots/{slotId}": { "schema": "TimeSlot", "description": "Slots" },
    "/schedule_blocks/{blockId}": { "schema": "ScheduleBlock", "description": "Blocks" },
    "/users/{userId}": { "schema": "User", "description": "Users" },
    "/roles_config/{roleId}": { "schema": "RoleConfig", "description": "Role configurations" },
    "/app_settings/{settingsId}": { "schema": "AppSettings", "description": "Global application settings" }
  }
}
