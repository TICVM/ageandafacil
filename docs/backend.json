
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER"] }
      }
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "schoolSegmentId": { "type": "string" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolClassId": { "type": "string" },
        "teacherName": { "type": "string", "description": "Nome digitado pelo professor no ato da reserva" },
        "photoLocationId": { "type": "string" },
        "appointmentDate": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" },
        "observations": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/school_classes/{classId}", "definition": { "entityName": "SchoolClass" } },
      { "path": "/appointments/{appointmentId}", "definition": { "entityName": "Appointment" } }
    ]
  }
}
