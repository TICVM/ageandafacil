
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SISTEMA DE AGENDAMENTO ESCOLAR - REGRAS PÚBLICAS E PRIVADAS
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Regras de Coleção ---

    // Dados públicos necessários para preencher o formulário de reserva
    match /school_segments/{segmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /school_classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /photo_locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /available_time_slots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Agendamentos: Qualquer pessoa pode criar, mas apenas logados veem/editam
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /roles_admin/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}
