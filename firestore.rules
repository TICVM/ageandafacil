rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SISTEMA DE AGENDAMENTO ESCOLAR - REGRAS DE SEGURANÇA
     */

    // --- Funções Auxiliares Globais ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Regras de Coleção ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /school_segments/{segmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /school_classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /photo_locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /scheduling_configuration/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /available_time_slots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
      // Permite ler se for admin ou o professor dono do agendamento
      allow get: if isSignedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid);
      
      // Permite listar se estiver logado. 
      // O Firestore garantirá que a query contenha os filtros necessários se as regras forem restritivas.
      allow list: if isSignedIn(); 
      
      // Permite criar se o teacherId no dado for o próprio usuário
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.teacherId == request.auth.uid);
      
      // Permite atualizar ou deletar se for o dono ou admin
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.teacherId == request.auth.uid));
    }
  }
}