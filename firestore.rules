rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras abertas para permitir leitura e gravação completa das coleções do sistema
    match /school_segments/{segmentId} {
      allow read, write: if true;
    }

    match /school_classes/{classId} {
      allow read, write: if true;
    }

    match /school_subjects/{subjectId} {
      allow read, write: if true;
    }

    match /photo_locations/{locationId} {
      allow read, write: if true;
    }

    match /available_time_slots/{slotId} {
      allow read, write: if true;
    }

    match /schedule_blocks/{blockId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /roles_config/{roleId} {
      allow read, write: if true;
    }
    
    match /app_settings/{settingsId} {
      allow read, write: if true;
    }
    
    match /roles_admin/{adminId} {
      allow read, write: if true;
    }

    match /holidays/{holidayId} {
      allow read, write: if true;
    }
    match /holidays/{document=**} {
      allow read, write: if true;
    }

    match /publications/{pubId} {
      allow read, write: if true;
    }
    match /publication_categories/{catId} {
      allow read, write: if true;
    }
    match /publication_series/{seriesId} {
      allow read, write: if true;
    }
    match /production_deadlines/{deadlineId} {
      allow read, write: if true;
    }
    match /calendar_settings/{settingId} {
      allow read, write: if true;
    }

    // Regra padrão
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
