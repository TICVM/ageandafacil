
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Dados públicos necessários para preencher o formulário de reserva
    match /school_segments/{segmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /school_classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /photo_locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /available_time_slots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /schedule_blocks/{blockId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Agendamentos: Qualquer pessoa pode criar, mas apenas logados veem/editam no dashboard
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Configurações de Perfis e Permissões
    match /roles_config/{roleId} {
      allow read, write: if isSignedIn();
    }
    
    // Legado (se houver)
    match /roles_admin/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}
