
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Dados públicos necessários para preencher o formulário de reserva
    match /school_segments/{segmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /school_classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /school_subjects/{subjectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /photo_locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /available_time_slots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /schedule_blocks/{blockId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Agendamentos: Qualquer pessoa pode criar e ver (para checar disponibilidade), 
    // mas apenas logados editam no dashboard
    match /appointments/{appointmentId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // Usuários: Leitura pública para permitir o Agendamento Rápido via e-mail
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Configurações de Perfis e Permissões
    match /roles_config/{roleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Configurações globais do App
    match /app_settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Legado (se houver)
    match /roles_admin/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}
